    const deltaEl = document.createElement('span');
    deltaEl.id = 'panel-score-delta';
    deltaEl.className = 'delta ' + (delta > 0 ? 'good' : delta < 0 ? 'bad' : 'neutral');
    deltaEl.style.cssText = 'margin-left:10px;font-size:16px;vertical-align:middle';
    deltaEl.textContent = (delta > 0 ? '+' : '') + delta + ' vs ' + (mode === 'base' ? 'base' : 'last');
    document.getElementById('panel-score').insertAdjacentElement('afterend', deltaEl);
  }
  const couples = Array.isArray(file.meta.temporalCoupling) ? [...file.meta.temporalCoupling].sort((a, b) => b.pct - a.pct) : [];
  const metaItems = [
    ['survivalPct', (file.meta.survivalPct || 0) + '%'],
    ['recentAuthors', listLabel(file.meta.recentAuthors)],
    ['knowledgeCliff', boolLabel(file.meta.knowledgeCliff)],
    ['refactorCount', file.meta.refactorCount || 0],
    ['temporalCoupling', couples.length ? couples.length + ' linked files' : '—'],
    ['isOrphan', boolLabel(file.meta.isOrphan)],
    ['deadExports', file.meta.deadExports || 0],
  ];
  document.getElementById('panel-meta').innerHTML = metaItems.map(([label, value]) => {
    return '<div class="meta-item"><span class="meta-label">' + escapeHtml(label) + '</span><span class="meta-value">' + escapeHtml(value) + '</span></div>';
  }).join('');
  document.getElementById('panel-coupling').innerHTML = couples.length
    ? '<h3>Temporal coupling</h3><ul>' + couples.slice(0, 5).map((couple) => {
        return '<li><span>' + escapeHtml(couple.file) + '</span><strong>' + couple.pct + '%</strong></li>';
      }).join('') + '</ul>'
    : '';
  const prompt = buildLlmPrompt(file);
  document.getElementById('panel-prompt').innerHTML =
    '<div class="llm-prompt">' +
      '<div class="llm-prompt-head">' +
        '<span class="llm-prompt-title"><strong>LLM prompt</strong><span>Ready-to-use refactor brief for this file.</span></span>' +
        '<button type="button" id="copy-prompt-btn" class="copy-btn" onclick="copyPrompt(\'' + encodeURIComponent(file.path) + '\')">Copy</button>' +
      '</div>' +
      '<div class="llm-prompt-body"><textarea id="llm-prompt-text" class="prompt-box" readonly>' + escapeHtml(prompt) + '</textarea></div>' +
    '</div>';
  document.getElementById('panel-signals').innerHTML = SIGNALS.map((signal) => {
    const value = Math.round(file.signals[signal] || 0);
    const color = scoreTone(value);
    let cmpBar = '';
    if (cmpFile) {
      const cmpVal = Math.round(cmpFile.signals[signal] || 0);
      cmpBar = '<div style="position:absolute;top:0;left:0;height:100%;width:' + cmpVal + '%;background:rgba(0,0,0,0.15);border-radius:999px"></div>';
    }
    return '<div class="signal-row">' +
      '<div class="signal-name">' + signal + '<span class="signal-info" tabindex="0" data-tip="' + escapeHtml(SIGNAL_EXPLANATIONS[signal]) + '" aria-label="' + escapeHtml(SIGNAL_EXPLANATIONS[signal]) + '">i</span></div>' +
      '<div class="signal-bar-wrap" style="position:relative">' + cmpBar + '<div class="signal-bar" style="width:' + value + '%;background:' + color + '"></div></div>' +
      '<div class="signal-val">' + value + '</div>' +
      '</div>';
  }).join('');
  document.getElementById('panel-explanation').innerHTML = '';
  document.getElementById('panel').classList.add('open');
  document.querySelector('.panel-close').focus();
}
function closePanel() { document.getElementById('panel').classList.remove('open'); }
function renderTable() {
  const cmp = getCompareSnapshot();
  const cmpMap = cmp ? new Map(cmp.files.map((file) => [file.path, file])) : null;
  const showDelta = cmpMap !== null;
  const filter = filterInput.value.trim().toLowerCase();
  const columnTips = {
    archetype: 'Debt archetype is the dominant code-health pattern in a file (for example: The Ghost, Spaghetti, or Time Bomb).',
  };
  const columns = [
    ['path', 'File'], ['level', 'Level'], ['score', 'Health'],
    ['recentAuthors', 'Recent authors'], ['refactorCount', 'Refactors'], ['temporalCoupling', 'Temporal coupling'],
    ['archetype', 'Archetype'],
    ...(showDelta ? [['delta', 'Δ Health']] : []),
    ['churn', 'Churn'], ['coverage', 'Coverage gap'], ['complexity', 'Complexity'],
    ['knowledge', 'Knowledge risk'], ['docs', 'Docs'], ['deps', 'Deps'],
    ['survivalPct', 'Survival %'], ['knowledgeCliff', 'Cliff'],
    ['isOrphan', 'Orphan'], ['deadExports', 'Dead exports'],
    ['action', ''],
  ];
  document.getElementById('table-head').innerHTML = '<tr>' + columns.map((column) => {
    if (column[0] === 'action') return '<th class="action-cell" aria-label="Actions"></th>';
    const tip = columnTips[column[0]]
      ? '<span class="signal-info header-info" tabindex="0" data-tip="' + escapeHtml(columnTips[column[0]]) + '" title="' + escapeHtml(columnTips[column[0]]) + '" aria-label="' + escapeHtml(columnTips[column[0]]) + '" onclick="event.stopPropagation()">i</span>'
      : '';
    const label = '<span style="display:inline-flex;align-items:center;gap:6px">' + column[1] + tip + '</span>';
    return '<th onclick="sortBy(\'' + column[0] + '\')">' + label + (sortKey === column[0] ? (sortAsc ? ' ↑' : ' ↓') : '') + '</th>';
  }).join('') + '</tr>';
  const files = [...DATA.files].filter((file) => !filter || file.path.toLowerCase().includes(filter)).sort((a, b) => {
    let av, bv;
    if (sortKey === 'path') { av = a.path; bv = b.path; }
    else if (sortKey === 'level') { av = LEVEL_RANK[a.level]; bv = LEVEL_RANK[b.level]; }
    else if (sortKey === 'score') { av = toHealthScore(a.score); bv = toHealthScore(b.score); }
    else if (sortKey === 'delta' && cmpMap) {
      av = toHealthScore(a.score) - toHealthScore(cmpMap.get(a.path) ? cmpMap.get(a.path).score : a.score);
      bv = toHealthScore(b.score) - toHealthScore(cmpMap.get(b.path) ? cmpMap.get(b.path).score : b.score);
    } else if (sortKey === 'survivalPct') { av = a.meta.survivalPct || 0; bv = b.meta.survivalPct || 0; }
    else if (sortKey === 'recentAuthors') { av = (a.meta.recentAuthors || []).length; bv = (b.meta.recentAuthors || []).length; }
    else if (sortKey === 'knowledgeCliff') { av = a.meta.knowledgeCliff ? 1 : 0; bv = b.meta.knowledgeCliff ? 1 : 0; }
    else if (sortKey === 'refactorCount') { av = a.meta.refactorCount || 0; bv = b.meta.refactorCount || 0; }
    else if (sortKey === 'temporalCoupling') { av = (a.meta.temporalCoupling || []).length; bv = (b.meta.temporalCoupling || []).length; }
    else if (sortKey === 'isOrphan') { av = a.meta.isOrphan ? 1 : 0; bv = b.meta.isOrphan ? 1 : 0; }
    else if (sortKey === 'deadExports') { av = a.meta.deadExports || 0; bv = b.meta.deadExports || 0; }
    else { av = a.signals[sortKey] || 0; bv = b.signals[sortKey] || 0; }
    if (av < bv) return sortAsc ? -1 : 1;
    if (av > bv) return sortAsc ? 1 : -1;
    return 0;
  });
  if (files.length === 0) {
    document.getElementById('table-body').innerHTML = '<tr><td class="empty-row" colspan="' + columns.length + '">No files match this filter.</td></tr>';
    const fileCountEl = document.getElementById('file-list-count');
    if (fileCountEl) fileCountEl.textContent = 'Showing 0 of 0 files';
    const fileMore = document.getElementById('file-list-more');
    const fileLess = document.getElementById('file-list-less');
    if (fileMore) fileMore.style.display = 'none';
    if (fileLess) fileLess.style.display = 'none';
    return;
  }
  const visibleFiles = files.slice(0, visibleFileRows);
  document.getElementById('table-body').innerHTML = visibleFiles.map((file) => {
    let deltaCell = '';
    if (showDelta) {
      const before = cmpMap.get(file.path);
      if (!before) {
        deltaCell = '<td class="delta-pos">new</td>';
      } else {
        const delta = toHealthScore(file.score) - toHealthScore(before.score);
        if (delta === 0) deltaCell = '<td class="delta-neu">stable</td>';
        else if (delta > 0) deltaCell = '<td class="delta-neg">+' + delta + '</td>';
        else deltaCell = '<td class="delta-pos">' + delta + '</td>';
      }
    }
    return '<tr onclick="openPanelByPath(\'' + encodeURIComponent(file.path) + '\')" style="cursor:pointer">' +
      '<td class="file-cell">' + escapeHtml(file.path) + '</td>' +
      '<td><span class="level-pill" style="background:' + levelColor(file.level) + '">' + file.level + '</span></td>' +
      '<td style="color:var(--ink);font-weight:850">' + toHealthScore(file.score) + '</td>' +
      '<td>' + escapeHtml(listLabel(file.meta.recentAuthors)) + '</td>' +
      '<td>' + (file.meta.refactorCount || 0) + '</td>' +
      '<td>' + escapeHtml(strongestCoupling(file)) + '</td>' +
      '<td style="color:var(--muted);font-size:11px;font-weight:700">' + escapeHtml(archetypeTableLabel(file)) + '</td>' +
      deltaCell +
      '<td>' + Math.round(file.signals.churn) + '</td>' +
      '<td>' + Math.round(file.signals.coverage) + '</td>' +
      '<td>' + Math.round(file.signals.complexity) + '</td>' +
      '<td>' + Math.round(file.signals.knowledge) + '</td>' +
      '<td>' + Math.round(file.signals.docs) + '</td>' +
      '<td>' + Math.round(file.signals.deps) + '</td>' +
      '<td>' + (file.meta.survivalPct || 0) + '%</td>' +
      '<td>' + boolLabel(file.meta.knowledgeCliff) + '</td>' +
      '<td>' + boolLabel(file.meta.isOrphan) + '</td>' +
      '<td>' + (file.meta.deadExports || 0) + '</td>' +
      '<td class="action-cell"><button type="button" class="view-btn" onclick="event.stopPropagation(); openPanelByPath(\'' + encodeURIComponent(file.path) + '\')">View</button></td>' +
      '</tr>';
  }).join('');
  const fileCountEl = document.getElementById('file-list-count');
  if (fileCountEl) fileCountEl.textContent = 'Showing ' + visibleFiles.length + ' of ' + files.length + ' files';
  const fileMore = document.getElementById('file-list-more');
  const fileLess = document.getElementById('file-list-less');
  if (fileMore) fileMore.style.display = visibleFiles.length < files.length ? 'inline-flex' : 'none';
  if (fileLess) fileLess.style.display = visibleFiles.length > FILE_PAGE_SIZE ? 'inline-flex' : 'none';
}
function sortBy(key) {
  if (sortKey === key) sortAsc = !sortAsc;
  else { sortKey = key; sortAsc = false; }
  renderTable();
}
function setupHistoryControls() {
  const toggleBar = document.getElementById('toggle-bar');
  toggleBar.style.display = 'flex';
  document.getElementById('btn-base').disabled = HISTORY.length < 1;
  document.getElementById('btn-last').disabled = HISTORY.length < 2;
}
function renderNarrative() {
  const el = document.getElementById('narrative-body');
  if (!el) return;
  const raw = DATA.summary.narrative || '';
  if (!raw) return;
  el.innerHTML = raw.split('\n\n').filter(Boolean).map((p) => '<p>' + escapeHtml(p.trim()) + '</p>').join('');
}
function renderOrphans() {
  const orphans = DATA.files.filter((f) => {
    const meta = f.meta || {};
    return Boolean(meta.isOrphan) || f.archetype === 'ghost' || (meta.deadExports || 0) > 0;
  });
  const section = document.getElementById('orphan-section');
  if (!section) return;
  section.style.display = 'block';
  const totalLOC = orphans.reduce((s, f) => s + (f.meta.linesOfCode || 0), 0);
  const badge = document.getElementById('orphan-badge');
  if (badge) badge.textContent = orphans.length + ' files · ' + totalLOC + ' lines';
  const tbody = document.getElementById('orphan-table-body');
  if (!tbody) return;
  if (!orphans.length) {
    section.classList.add('is-empty');
    tbody.innerHTML = '<tr><td colspan="5" class="empty-row">No orphan files detected in this report.</td></tr>';
    const orphanCount = document.getElementById('orphan-list-count');
    if (orphanCount) orphanCount.textContent = 'Showing 0 of 0 orphan files';
    const orphanMore = document.getElementById('orphan-list-more');
    const orphanLess = document.getElementById('orphan-list-less');
    if (orphanMore) orphanMore.style.display = 'none';
    if (orphanLess) orphanLess.style.display = 'none';
    return;
  }
  section.classList.remove('is-empty');
  const sortedOrphans = orphans.sort((a, b) => (b.meta.linesOfCode || 0) - (a.meta.linesOfCode || 0));
  const visibleOrphans = sortedOrphans.slice(0, visibleOrphanRows);
  tbody.innerHTML = visibleOrphans.map((file) => {
    return '<tr onclick="openPanelByPath(\'' + encodeURIComponent(file.path) + '\')">' +
      '<td class="orphan-file-cell">' + escapeHtml(file.path) + '</td>' +
      '<td style="color:' + levelColor(file.level) + ';font-weight:800">' + file.score + '</td>' +
      '<td><span class="level-pill" style="background:' + levelColor(file.level) + '">' + file.level + '</span></td>' +
      '<td>' + (file.meta.linesOfCode || 0) + '</td>' +
      '<td>' + (file.meta.deadExports > 0 ? file.meta.deadExports + ' unused' : '<span style="color:var(--quiet)">—</span>') + '</td>' +
      '</tr>';
  }).join('');
  const orphanCount = document.getElementById('orphan-list-count');
  if (orphanCount) orphanCount.textContent = 'Showing ' + visibleOrphans.length + ' of ' + sortedOrphans.length + ' orphan files';
  const orphanMore = document.getElementById('orphan-list-more');
  const orphanLess = document.getElementById('orphan-list-less');
  if (orphanMore) orphanMore.style.display = visibleOrphans.length < sortedOrphans.length ? 'inline-flex' : 'none';
  if (orphanLess) orphanLess.style.display = visibleOrphans.length > ORPHAN_PAGE_SIZE ? 'inline-flex' : 'none';
}
filterInput.addEventListener('input', () => {
  visibleFileRows = FILE_PAGE_SIZE;
  renderTable();
});
document.getElementById('file-list-more').addEventListener('click', () => {
  visibleFileRows += FILE_PAGE_SIZE;
  renderTable();
});
document.getElementById('file-list-less').addEventListener('click', () => {
  visibleFileRows = FILE_PAGE_SIZE;
  renderTable();
});
document.getElementById('orphan-list-more').addEventListener('click', () => {
  visibleOrphanRows += ORPHAN_PAGE_SIZE;
  renderOrphans();
});
document.getElementById('orphan-list-less').addEventListener('click', () => {
  visibleOrphanRows = ORPHAN_PAGE_SIZE;
  renderOrphans();
});
let headerTooltipEl = null;
function hideHeaderTooltip() {
  if (headerTooltipEl) {
    headerTooltipEl.remove();
    headerTooltipEl = null;
  }
}
function showHeaderTooltip(target) {
  hideHeaderTooltip();
  const tip = target && target.getAttribute('data-tip');
  if (!tip) return;
  const pop = document.createElement('div');
  pop.className = 'header-tip-popover';
  pop.textContent = tip;
  document.body.appendChild(pop);
  const rect = target.getBoundingClientRect();
  const popRect = pop.getBoundingClientRect();
  const gap = 8;
  let left = rect.left + (rect.width / 2) - (popRect.width / 2);
  left = Math.max(10, Math.min(left, window.innerWidth - popRect.width - 10));
  let top = rect.bottom + gap;
  if (top + popRect.height > window.innerHeight - 8) top = rect.top - popRect.height - gap;
  pop.style.left = Math.round(left) + 'px';
  pop.style.top = Math.round(Math.max(8, top)) + 'px';
  headerTooltipEl = pop;
}
document.addEventListener('mouseover', (event) => {
  const target = event.target && event.target.closest ? event.target.closest('.signal-info.header-info') : null;
  if (target) showHeaderTooltip(target);
  else hideHeaderTooltip();
});
document.addEventListener('focusin', (event) => {
  const target = event.target && event.target.matches && event.target.matches('.signal-info.header-info') ? event.target : null;
  if (target) showHeaderTooltip(target);
});
document.addEventListener('focusout', (event) => {
  const target = event.target && event.target.matches && event.target.matches('.signal-info.header-info');
  if (target) hideHeaderTooltip();
});
window.addEventListener('scroll', hideHeaderTooltip, true);
document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closePanel(); });
window.addEventListener('resize', () => { renderTreemap(); });
setupHistoryControls();
updateAverageDelta();
renderNarrative();
renderLevelList();
renderGauge();
renderHotspots();
renderActivity();
renderTrend();
renderRiskBars();
renderTreemap();
renderTable();
renderOrphans();
</script>
